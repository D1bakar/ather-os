{
  "$schema": "https://aether-os.dev/schemas/release-manifest-v1.json",
  "schema_version": 1,
  "product": "aether-os",
  "version": "0.1.0",
  "git_commit": "REPLACE_WITH_GIT_SHA",
  "generated_at": "REPLACE_WITH_ISO8601_UTC",
  "boot": {
    "architecture": "x86_64",
    "firmware": "uefi",
    "layout": "esp-fat32",
    "verified_runtime": ["qemu-system-x86_64+ovmf"],
    "browser_runtime": {
      "status": "not_available",
      "target": "qemu.wasm",
      "blocker": "UEFI/OVMF required; v86 SeaBIOS cannot boot BOOTX64.EFI"
    }
  },
  "artifacts": [
    {
      "path": "EFI/BOOT/BOOTX64.EFI",
      "role": "uefi-boot-loader",
      "sha256": "REPLACE_WITH_SHA256_HEX",
      "size_bytes": 0
    },
    {
      "path": "aether/kernel.elf",
      "role": "kernel",
      "sha256": "REPLACE_WITH_SHA256_HEX",
      "size_bytes": 0
    }
  ],
  "optional_artifacts": [
    {
      "path": "aether.img",
      "role": "raw-disk-image",
      "sha256": "REPLACE_WITH_SHA256_HEX",
      "size_bytes": 0,
      "note": "Generated by aether-img-builder when build/aether.img exists"
    }
  ],
  "qemu_smoke": {
    "machine": "q35",
    "memory_mb": 256,
    "serial_patterns": [
      "Aether OS kernel started",
      "Aether OS M6: userland started",
      "Aether init started"
    ]
  }
}
